{
  "name": "@filecheap/platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "scripts": {
    "audit:production": "bun audit --production",
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "e2e:local": "bun tests/local-protocol.e2e.ts",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "bun run lint && bun run typecheck && bun test && bun run e2e:local"
  },
  "dependencies": {
    "@vercel/blob": "2.6.1",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "typescript": "5.9.3"
  }
}
