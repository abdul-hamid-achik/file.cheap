# Bare HTTP(S) origin only: no credentials, path, query, or fragment.
# Production requires HTTPS except for an explicit loopback origin.
PLATFORM_PUBLIC_URL=http://127.0.0.1:3100
# Required by private artifact routes only. The public site and docs do not
# read these variables. Use distinct random values and keep them in tvault.
# DATABASE_URL=postgresql://pooled-runtime-url
# Receipt signing is loaded only by the private ArtifactService factory. Both
# JSON maps must contain the same 1-16 key IDs. Each value is a distinct,
# canonical base64url encoding of 32-64 random bytes; signing and lookup
# material must never be reused. Keep the previous kid loaded during rotation.
# FILECHEAP_PLAN_RECEIPT_ACTIVE_KID=2026-07
# FILECHEAP_PLAN_RECEIPT_SIGNING_KEYS={"2026-07":"<base64url-signing-key>"}
# FILECHEAP_PLAN_RECEIPT_LOOKUP_KEYS={"2026-07":"<base64url-lookup-key>"}
# External publishers authenticate with one producer-bound current token and,
# only during rotation, one next token. Every policy is an exact allowlist.
# Tokens are 43-128 base64url characters. Keep this compact JSON in Vercel;
# external processes receive only their own token as FILECHEAP_INGEST_TOKEN.
# FILECHEAP_PUBLISHER_TOKENS={"cairntrace":{"kinds":["cairntrace.run"],"nativeSchemas":["urn:cairntrace.dev:run:v1"],"tokens":["<publisher-token>"]},"glyphrun":{"kinds":["glyphrun.evidence-pack"],"nativeSchemas":["urn:glyphrun.dev:run:v1"],"tokens":["<publisher-token>"]}}
# Prefer Vercel OIDC for Vercel-to-Vercel producers. All three values are
# required together; subjects are comma-separated exact Chalupa deployment
# subjects. Production must allow only Chalupa's production subject.
# FILECHEAP_OIDC_ISSUER=https://oidc.vercel.com/<team-slug>
# FILECHEAP_OIDC_AUDIENCE=https://vercel.com/<team-slug>
# FILECHEAP_OIDC_SUBJECTS=owner:<team-slug>:project:chalupa:environment:production
# FILECHEAP_ADMIN_TOKEN=
# CRON_SECRET=
# Required by the private Vercel Blob adapter when the Vercel integration does
# not supply an OIDC-backed credential automatically.
# BLOB_READ_WRITE_TOKEN=
# Never put MIGRATIONS_DATABASE_URL in Vercel. A protected GitHub Actions job
# uses the direct Neon URL only while applying Drizzle migrations.
# Local integration tests use an ephemeral Docker database by default. To use
# an already-running test database, set FILECHEAP_POSTGRES_TEST_URL explicitly;
# its database name must contain a standalone "test" segment. Remote test
# databases additionally require FILECHEAP_ALLOW_REMOTE_TEST_DATABASE=true.

# Private console/device authorization. These are read lazily only by
# /console and /api/console; the public site and health route remain healthy
# without them. The first release permits exactly this owner email and does
# not expose signup, teams, or sharing.
# FILECHEAP_OWNER_EMAIL=owner@example.com
# Stable opaque owner identifier shared by console auth and trusted producer
# policies. Example: acc_ followed by at least eight random URL-safe chars.
# FILECHEAP_OWNER_ACCOUNT_ID=acc_replace_with_random_id
# Random 32+ byte secret used to HMAC OTP and session material.
# FILECHEAP_AUTH_SECRET=
# Optional 30-300 second lease for one recoverable Resend attempt. Defaults to
# 120; retries reuse the same derived OTP and provider idempotency key.
# FILECHEAP_VERIFICATION_DELIVERY_LEASE_SECONDS=120
# Dedicated send-only Resend credential; never reuse RESEND_RECEIVE_API_KEY.
# RESEND_AUTH_SEND_API_KEY=
# Verified sender, for example: file.cheap <auth@file.cheap>
# RESEND_AUTH_FROM=

# Inbound mail is independent from the public site and artifact service.
# This Resend receiving key has team-wide full access. Keep it Production-only
# and expose it only to this server-side webhook route.
# RESEND_RECEIVE_API_KEY=
# RESEND_WEBHOOK_SECRET=
# Private forwarding destination. Never commit a real address.
# RESEND_FORWARD_TO=
