# Local development defaults are intentionally obvious. The app rejects them
# whenever NODE_ENV=production or Vercel is detected.
PLATFORM_STORAGE_DRIVER=local
PLATFORM_API_TOKEN=local-development-token
PLATFORM_SIGNING_SECRET=local-development-signing-secret-change-me
# Bare HTTP(S) origin only: no credentials, path, query, or fragment.
# Production requires HTTPS except for an explicit loopback origin.
PLATFORM_PUBLIC_URL=http://127.0.0.1:3100
# Optional test isolation override; must be an absolute path.
# PLATFORM_DATA_DIR=/tmp/filecheap-platform

# Required only when PLATFORM_STORAGE_DRIVER=vercel-blob.
# BLOB_READ_WRITE_TOKEN=
# Explicit acknowledgement for a controlled Blob spike. Do not enable for users:
# a direct Blob PUT cannot prove the caller-declared SHA-256 or repair a poisoned
# immutable pathname yet.
# PLATFORM_BLOB_INTEGRITY=presence-size-etag-experimental
