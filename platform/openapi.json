{
  "openapi": "3.1.1",
  "info": {
    "title": "file.cheap private artifact service",
    "version": "1.0.0",
    "description": "A single-owner control plane for immutable private artifacts. Control-plane JSON is bounded; artifact bytes move directly through one exact short-lived private Blob grant. Chalupa's Vercel service authenticates with a verified OIDC token whose issuer, audience, and subject are allowlisted. External publishers use a rotated bearer credential bound to one exact producer, artifact-kind allowlist, and native-schema allowlist."
  },
  "servers": [{ "url": "/", "description": "Current file.cheap origin" }],
  "paths": {
    "/api/v1/health": { "get": { "operationId": "getHealth", "summary": "Read public site health without initializing private storage", "tags": ["System"], "parameters": [{ "$ref": "#/components/parameters/RequestId" }], "responses": { "200": { "description": "The public site is healthy.", "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicHealth" }, "examples": { "public": { "value": { "deployment": "public-site", "status": "ok", "version": "filecheap-site/2" } } } } } } } } },
    "/api/v1/openapi.json": { "get": { "operationId": "getOpenApiDocument", "summary": "Read the private artifact-service contract", "tags": ["System"], "responses": { "200": { "description": "OpenAPI 3.1 document." } } } },
    "/api/v1/artifacts": { "get": { "operationId": "listArtifacts", "summary": "List one bounded private artifact page", "description": "Administrator access only. Results are ordered by a stable opaque artifact cursor; pass nextCursor as after to continue. The response contains committed artifacts only.", "tags": ["Artifacts"], "security": [{ "adminBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/RequestId" }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } }, { "name": "after", "in": "query", "schema": { "$ref": "#/components/schemas/ArtifactId" } }], "responses": { "200": { "description": "Bounded artifact page.", "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArtifactList" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "422": { "$ref": "#/components/responses/ValidationError" }, "503": { "$ref": "#/components/responses/ServiceUnavailable" } } } },
    "/api/v1/artifacts/{artifactId}": { "get": { "operationId": "getArtifact", "summary": "Read committed artifact metadata", "tags": ["Artifacts"], "security": [{ "adminBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/RequestId" }, { "name": "artifactId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ArtifactId" } }], "responses": { "200": { "description": "Committed artifact and canonical ArtifactRefV1.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArtifactSummary" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } } } },
    "/api/v1/artifacts/plans": { "post": { "operationId": "planArtifactUpload", "summary": "Plan one immutable direct upload", "description": "An ingest caller supplies a UUID idempotency key, declared SHA-256, size, retention expiry, and producer metadata. The authenticated principal must allow the exact producer.tool, kind, and producer.native_schema, and the declared sizeBytes must fit that producer's own quota; a larger declaration is rejected with 413 naming the producer and its quota. Reusing the same key with different content returns 409. Reusing the same complete plan after its up-to-15-minute transfer grant expires renews the exact immutable plan; if bytes reached storage before an ambiguous response, the caller may continue to commit them after a non-overwrite PUT conflict. Every plan and PUT grant is capped at the artifact retention timestamp, and no replacement grant is issued once retention begins. Replaying an exact already-committed plan returns 200 with the durable artifact summary and no new transfer capability. A plan currently being reconciled returns a retryable 409. A returned PUT URL is short-lived, exact-path, non-overwrite, size/content-type constrained, and must never be stored in ArtifactRefV1 or logs.", "tags": ["Ingest"], "security": [{ "ingestOidcOrBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/RequestId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArtifactPlanInput" } } } }, "responses": { "200": { "description": "Exact idempotent replay of an already-committed artifact; no upload grant is issued.", "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArtifactPlanReplayResponse" } } } }, "201": { "description": "New or safely renewed plan and exact signed PUT grant.", "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArtifactPlanResponse" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "409": { "$ref": "#/components/responses/Conflict" }, "413": { "$ref": "#/components/responses/PayloadTooLarge" }, "422": { "$ref": "#/components/responses/ValidationError" }, "503": { "$ref": "#/components/responses/ServiceUnavailable" } } } },
    "/api/v1/artifacts/commits": { "post": { "operationId": "commitArtifactUpload", "summary": "Verify and commit a planned upload", "description": "The service resolves the opaque receipt and rechecks its producer, kind, and native schema against the authenticated principal before reading private storage. It then rechecks the producer quota, streams the bounded private object, and recomputes its SHA-256 incrementally at constant memory before returning server-sha256. The final state transition atomically verifies that retention is still active, so a commit fails closed if object verification crosses that boundary. Repeating the same receipt is idempotent while the committed artifact remains retained, even after the former transfer grant expires. An expired receipt cannot commit an artifact that is still planned. The receipt is not an ArtifactRefV1 field and must not be retained by consumers outside the producer's durable delivery state.", "tags": ["Ingest"], "security": [{ "ingestOidcOrBearer": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArtifactCommitInput" } } } }, "responses": { "200": { "description": "Committed verified artifact.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArtifactSummary" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "409": { "$ref": "#/components/responses/Conflict" }, "413": { "$ref": "#/components/responses/PayloadTooLarge" }, "422": { "$ref": "#/components/responses/ValidationError" }, "503": { "$ref": "#/components/responses/ServiceUnavailable" } } } },
    "/api/v1/artifacts/downloads": { "post": { "operationId": "planArtifactDownload", "summary": "Issue one exact private download grant", "description": "The single-owner administrator may request any retained committed artifact by ID. Chalupa's exact allowlisted Vercel OIDC identity is restricted to retained committed chalupa.log-chunk artifacts produced by Chalupa with the allowlisted native schema; a mismatched or expired artifact is returned as not found before private storage is inspected. Publisher credentials are rejected. The returned GET URL is a short-lived transfer capability capped at the artifact retention timestamp, not a stable artifact reference.", "tags": ["Artifacts"], "security": [{ "adminBearer": [] }, { "chalupaOidc": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArtifactDownloadInput" } } } }, "responses": { "201": { "description": "Exact signed GET grant.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArtifactDownloadResponse" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "503": { "$ref": "#/components/responses/ServiceUnavailable" } } } },
    "/api/internal/retention": { "get": { "operationId": "reconcileArtifactRetention", "summary": "Run the leased private retention workflow", "description": "Vercel Cron only. One database-fenced run executes bounded artifact, inbound replay, authorization, session, device-family, and rate-limit stages. Each stage continues after ordinary cleanup failures, while loss of the run heartbeat aborts the worker before more destructive work. Run state and its allowlisted append-only activity event transition atomically. A partial or failed run is terminally persisted before the route returns a retryable 503.", "tags": ["Operations"], "security": [{ "cronBearer": [] }], "responses": { "200": { "description": "Successful bounded retention run.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RetentionRunReport" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "409": { "$ref": "#/components/responses/Conflict" }, "503": { "$ref": "#/components/responses/ServiceUnavailable" } } } },
    "/api/internal/retention/health": { "get": { "operationId": "getPrivateRetentionHealth", "summary": "Read private retention health", "description": "Cron-authenticated internal synthetic only. Reports the current fenced run, latest terminal counters, and the oldest still-due private cleanup item without changing state.", "tags": ["Operations"], "security": [{ "cronBearer": [] }], "responses": { "200": { "description": "Private retention health snapshot.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RetentionHealthReport" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "503": { "$ref": "#/components/responses/ServiceUnavailable" } } } }
  },
  "components": {
    "securitySchemes": { "adminBearer": { "type": "http", "scheme": "bearer", "description": "Single-owner administrator credential." }, "chalupaOidc": { "type": "http", "scheme": "bearer", "description": "Exact allowlisted Chalupa Vercel OIDC identity. Accepted only for committed chalupa.log-chunk artifacts produced by Chalupa with the allowlisted native schema; publisher bearer credentials are not accepted." }, "cronBearer": { "type": "http", "scheme": "bearer", "description": "Vercel Cron secret only." }, "ingestOidcOrBearer": { "type": "http", "scheme": "bearer", "description": "Exact Chalupa Vercel OIDC identity restricted to chalupa.log-chunk, or an external publisher credential bound to one exact producer.tool, kind allowlist, native_schema allowlist, and per-producer maxSizeBytes quota. Publisher credentials cannot authorize administrator, download, or retention routes." } },
    "parameters": { "RequestId": { "name": "X-Request-Id", "in": "header", "required": false, "description": "Optional opaque caller correlation ID.", "schema": { "type": "string", "maxLength": 256 } } },
    "headers": { "RequestId": { "description": "Opaque correlation ID returned on every JSON response.", "schema": { "type": "string" } }, "RetryAfter": { "description": "Seconds to wait before retrying a transient 503.", "schema": { "type": "string", "pattern": "^[0-9]+$" } }, "WwwAuthenticate": { "description": "Bearer authentication challenge.", "schema": { "type": "string" } } },
    "responses": { "BadRequest": { "description": "Malformed JSON, an expired receipt, or invalid capability.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }, "Unauthorized": { "description": "Missing, invalid, or wrong-scope private credential.", "headers": { "WWW-Authenticate": { "$ref": "#/components/headers/WwwAuthenticate" } }, "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }, "NotFound": { "description": "No committed artifact exists.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }, "Conflict": { "description": "Conflicting idempotency binding, incomplete upload, a plan under reconciliation, or missing committed object.", "headers": { "Retry-After": { "$ref": "#/components/headers/RetryAfter" } }, "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }, "PayloadTooLarge": { "description": "The declared artifact size exceeds the authenticated producer's own maxSizeBytes quota. The detail names the producer and its exact quota.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }, "ValidationError": { "description": "A strict request or query constraint failed.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }, "ServiceUnavailable": { "description": "Private Blob or Neon is temporarily unavailable.", "headers": { "Retry-After": { "$ref": "#/components/headers/RetryAfter" } }, "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } } },
    "schemas": {
      "PublicHealth": { "type": "object", "required": ["deployment", "status", "version"], "properties": { "deployment": { "const": "public-site" }, "status": { "const": "ok" }, "version": { "const": "filecheap-site/2" } }, "additionalProperties": false },
      "RetentionCounters": { "type": "object", "required": ["artifactCandidates", "artifactFailures", "artifactsDeleted", "consoleAuthorizationRecordsDeleted", "consoleDeviceFamilyRecordsDeleted", "consoleRateLimitRecordsDeleted", "consoleSessionRecordsDeleted", "inboundReplayRecordsDeleted", "stagesAttempted", "stagesFailed", "stagesSucceeded"], "properties": { "artifactCandidates": { "type": "integer", "minimum": 0 }, "artifactFailures": { "type": "integer", "minimum": 0 }, "artifactsDeleted": { "type": "integer", "minimum": 0 }, "consoleAuthorizationRecordsDeleted": { "type": "integer", "minimum": 0 }, "consoleDeviceFamilyRecordsDeleted": { "type": "integer", "minimum": 0 }, "consoleRateLimitRecordsDeleted": { "type": "integer", "minimum": 0 }, "consoleSessionRecordsDeleted": { "type": "integer", "minimum": 0 }, "inboundReplayRecordsDeleted": { "type": "integer", "minimum": 0 }, "stagesAttempted": { "type": "integer", "minimum": 0 }, "stagesFailed": { "type": "integer", "minimum": 0 }, "stagesSucceeded": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
      "RetentionRunReport": { "type": "object", "required": ["counters", "failedAreas", "finishedAt", "oldestDueAt", "runId", "startedAt", "status", "version"], "properties": { "counters": { "$ref": "#/components/schemas/RetentionCounters" }, "failedAreas": { "type": "array", "maxItems": 8, "items": { "enum": ["artifacts", "inbound_email_replays", "console_authorizations", "console_device_families", "console_sessions", "console_rate_limits", "backlog_probe", "run_lease"] } }, "finishedAt": { "type": "string", "format": "date-time" }, "oldestDueAt": { "type": ["string", "null"], "format": "date-time" }, "runId": { "type": "string", "pattern": "^rtn_[0-9a-f-]{36}$" }, "startedAt": { "type": "string", "format": "date-time" }, "status": { "const": "succeeded" }, "version": { "const": "filecheap-retention-run/1" } }, "additionalProperties": false },
      "RetentionHealthReport": { "type": "object", "required": ["activeRunCount", "counters", "lastFinishedAt", "lastRunId", "lastStartedAt", "oldestDueAt", "status", "version"], "properties": { "activeRunCount": { "type": "integer", "minimum": 0, "maximum": 1 }, "counters": { "$ref": "#/components/schemas/RetentionCounters" }, "lastFinishedAt": { "type": ["string", "null"], "format": "date-time" }, "lastRunId": { "type": ["string", "null"], "pattern": "^rtn_[0-9a-f-]{36}$" }, "lastStartedAt": { "type": ["string", "null"], "format": "date-time" }, "oldestDueAt": { "type": ["string", "null"], "format": "date-time" }, "status": { "type": ["string", "null"], "enum": ["running", "succeeded", "partial", "failed", "abandoned", null] }, "version": { "const": "filecheap-retention-health/1" } }, "additionalProperties": false },
      "ArtifactId": { "type": "string", "pattern": "^art_[A-Za-z0-9_-]{16,96}$" },
      "SHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "Producer": { "type": "object", "required": ["tool"], "properties": { "tool": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }, "version": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\\\-]*$" }, "native_schema": { "type": "string", "maxLength": 256, "pattern": "^(?:urn:[!-~]+|https://[!-~]+)$", "not": { "pattern": "(^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*@)|\\\\?" }, "description": "HTTPS URI or URN; userinfo and query are forbidden." }, "native_id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" }, "entrypoint": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$", "not": { "pattern": "(^|/)\\\\.\\\\.?(/|$)" } } }, "additionalProperties": false },
      "RunIndexV1": { "type": "object", "required": ["$schema", "version", "detector", "run", "health", "counts", "outcomes", "evidence"], "properties": { "$schema": { "const": "urn:filecheap.dev:run-index:v1" }, "version": { "const": 1 }, "detector": { "type": "object", "required": ["name", "version"], "properties": { "name": { "enum": ["cairntrace-run", "glyphrun-run"] }, "version": { "type": "string", "minLength": 1, "maxLength": 32 } }, "additionalProperties": false }, "run": { "type": "object", "required": ["nativeId", "seriesKey", "status"], "properties": { "nativeId": { "type": "string", "minLength": 1, "maxLength": 160 }, "seriesKey": { "type": "string", "minLength": 16, "maxLength": 128 }, "specName": { "type": "string", "maxLength": 240 }, "status": { "enum": ["queued", "running", "passed", "failed", "errored", "cancelled", "incomplete", "unknown"] }, "startedAt": { "type": "string", "format": "date-time" }, "endedAt": { "type": "string", "format": "date-time" }, "durationMs": { "type": "integer", "minimum": 0 }, "environment": { "type": "string", "maxLength": 80 }, "backend": { "type": "string", "maxLength": 80 }, "exitCode": { "type": "integer", "minimum": -255, "maximum": 255 }, "errorKind": { "type": "string", "maxLength": 160 } }, "additionalProperties": false }, "health": { "type": "object", "required": ["state", "reasons", "declared", "present", "empty", "missing", "changed"], "properties": { "state": { "enum": ["ok", "degraded", "incomplete", "unknown"] }, "reasons": { "type": "array", "maxItems": 16, "items": { "enum": ["required-member-missing", "declared-member-missing", "empty-capture", "size-mismatch", "hash-mismatch", "incomplete-run", "manifest-unavailable", "schema-drift"] } }, "declared": { "type": "integer", "minimum": 0 }, "present": { "type": "integer", "minimum": 0 }, "empty": { "type": "integer", "minimum": 0 }, "missing": { "type": "integer", "minimum": 0 }, "changed": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }, "counts": { "type": "object", "required": ["steps", "outcomes", "artifacts"], "properties": { "steps": { "type": "integer", "minimum": 0 }, "outcomes": { "type": "integer", "minimum": 0 }, "artifacts": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }, "outcomes": { "type": "array", "maxItems": 100, "items": { "type": "object", "required": ["id", "status"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 160 }, "status": { "enum": ["passed", "failed", "errored", "skipped", "unknown"] } }, "additionalProperties": false } }, "evidence": { "type": "array", "maxItems": 200, "items": { "type": "object", "required": ["path", "role", "medium", "presence", "integrity", "sensitivity", "inspectability"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 512 }, "role": { "type": "string", "minLength": 1, "maxLength": 64 }, "medium": { "enum": ["structured-text", "text", "image", "video", "archive", "binary", "unknown"] }, "presence": { "enum": ["declared", "present", "empty", "missing", "partial", "unknown"] }, "integrity": { "enum": ["verified", "declared", "changed", "unknown"] }, "sensitivity": { "enum": ["metadata-safe", "redacted", "potentially-sensitive", "secret-bearing", "unknown"] }, "inspectability": { "const": "metadata-only" }, "declaredBytes": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } } }, "additionalProperties": false, "description": "Bounded metadata-only projection supplied by a trusted Cairntrace or Glyphrun producer. It contains no raw evidence bytes." },
      "ArtifactRefV1": { "type": "object", "required": ["$schema", "version", "provider", "uri", "artifact_id", "kind"], "properties": { "$schema": { "const": "urn:filecheap.dev:artifact-ref:v1" }, "version": { "const": 1 }, "provider": { "const": "fcheap-cloud" }, "uri": { "type": "string", "pattern": "^fcheap://cloud/vaults/[A-Za-z0-9._-]+/artifacts/[A-Za-z0-9._-]+$" }, "artifact_id": { "$ref": "#/components/schemas/ArtifactId" }, "kind": { "type": "string", "maxLength": 128 }, "producer": { "$ref": "#/components/schemas/Producer" } }, "additionalProperties": false, "description": "Stable credential-free identity. Never contains a signed URL, receipt, token, query, or fragment." },
      "Artifact": { "type": "object", "required": ["artifactId", "committedAt", "contentType", "expiresAt", "kind", "producer", "sha256", "sizeBytes", "state", "verification"], "properties": { "artifactId": { "$ref": "#/components/schemas/ArtifactId" }, "committedAt": { "type": ["string", "null"], "format": "date-time" }, "contentType": { "type": "string", "maxLength": 255 }, "expiresAt": { "type": ["string", "null"], "format": "date-time" }, "kind": { "type": "string", "maxLength": 128 }, "producer": { "$ref": "#/components/schemas/Producer" }, "sha256": { "$ref": "#/components/schemas/SHA256" }, "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 }, "state": { "enum": ["planned", "committed", "deleting", "deleted"] }, "verification": { "const": "server-sha256" } }, "additionalProperties": false },
      "ArtifactSummary": { "type": "object", "required": ["artifact", "artifactRef"], "properties": { "artifact": { "$ref": "#/components/schemas/Artifact" }, "artifactRef": { "$ref": "#/components/schemas/ArtifactRefV1" } }, "additionalProperties": false },
      "ArtifactPlanInput": { "type": "object", "required": ["contentType", "idempotencyKey", "kind", "producer", "sha256", "sizeBytes"], "properties": { "contentType": { "type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$" }, "idempotencyKey": { "type": "string", "format": "uuid", "description": "One producer-generated UUID, canonicalized to lowercase. Reuse the same key only for the same complete plan; an expired transfer grant can be renewed without changing it." }, "expiresAt": { "type": "string", "format": "date-time", "description": "Optional artifact-retention expiry; must be in the future and at most 31 days away when the request is made." }, "kind": { "type": "string", "maxLength": 128 }, "producer": { "$ref": "#/components/schemas/Producer" }, "runIndex": { "$ref": "#/components/schemas/RunIndexV1" }, "sha256": { "$ref": "#/components/schemas/SHA256" }, "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 67108864, "description": "Exact artifact byte length. 67108864 is the global platform ceiling; each authenticated producer additionally has its own maxSizeBytes quota at or below it, and a declared size above that quota is rejected with 413." } }, "additionalProperties": false },
      "UploadGrant": { "type": "object", "required": ["expiresAt", "headers", "method", "url"], "properties": { "expiresAt": { "type": "string", "format": "date-time" }, "headers": { "type": "object", "additionalProperties": { "type": "string" }, "maxProperties": 16 }, "method": { "const": "PUT" }, "url": { "type": "string", "format": "uri", "description": "Ephemeral direct-upload capability. Do not persist or place in ArtifactRefV1." } }, "additionalProperties": false },
      "DownloadGrant": { "type": "object", "required": ["expiresAt", "headers", "method", "url"], "properties": { "expiresAt": { "type": "string", "format": "date-time" }, "headers": { "type": "object", "additionalProperties": { "type": "string" }, "maxProperties": 16 }, "method": { "const": "GET" }, "url": { "type": "string", "format": "uri", "description": "Ephemeral direct-download capability. Do not persist or place in ArtifactRefV1." } }, "additionalProperties": false },
      "ArtifactPlanResponse": { "type": "object", "required": ["artifact", "artifactRef", "receipt", "upload"], "properties": { "artifact": { "allOf": [{ "$ref": "#/components/schemas/Artifact" }, { "type": "object", "properties": { "committedAt": { "type": "null" }, "state": { "const": "planned" } } }] }, "artifactRef": { "$ref": "#/components/schemas/ArtifactRefV1" }, "receipt": { "type": "string", "format": "uuid", "description": "Opaque commit capability; never persist in an artifact reference." }, "upload": { "$ref": "#/components/schemas/UploadGrant" } }, "additionalProperties": false },
      "ArtifactPlanReplayResponse": { "type": "object", "required": ["artifact", "artifactRef"], "properties": { "artifact": { "allOf": [{ "$ref": "#/components/schemas/Artifact" }, { "type": "object", "properties": { "committedAt": { "type": "string", "format": "date-time" }, "state": { "const": "committed" } } }] }, "artifactRef": { "$ref": "#/components/schemas/ArtifactRefV1" } }, "additionalProperties": false },
      "ArtifactCommitInput": { "type": "object", "required": ["receipt"], "properties": { "receipt": { "type": "string", "format": "uuid" } }, "additionalProperties": false },
      "ArtifactDownloadInput": { "type": "object", "required": ["artifactId"], "properties": { "artifactId": { "$ref": "#/components/schemas/ArtifactId" } }, "additionalProperties": false },
      "ArtifactDownloadResponse": { "type": "object", "required": ["artifact", "artifactRef", "download"], "properties": { "artifact": { "$ref": "#/components/schemas/Artifact" }, "artifactRef": { "$ref": "#/components/schemas/ArtifactRefV1" }, "download": { "$ref": "#/components/schemas/DownloadGrant" } }, "additionalProperties": false },
      "ArtifactList": { "type": "object", "required": ["artifacts", "nextCursor", "version"], "properties": { "artifacts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/ArtifactSummary" } }, "nextCursor": { "type": ["string", "null"] }, "version": { "const": "filecheap-artifacts/1" } }, "additionalProperties": false },
      "Problem": { "type": "object", "required": ["type", "title", "status", "detail", "instance", "requestId", "code"], "properties": { "type": { "type": "string", "format": "uri-reference" }, "title": { "type": "string" }, "status": { "type": "integer" }, "detail": { "type": "string" }, "instance": { "type": "string" }, "requestId": { "type": "string" }, "code": { "type": "string" } }, "additionalProperties": false }
    }
  }
}
