{
  "openapi": "3.1.1",
  "info": {
    "title": "file.cheap recovery protocol",
    "version": "1.0.0-prototype",
    "description": "Provider-neutral control-plane API for the single-workspace file.cheap recovery lab. Archive bytes move through exact signed transfer grants rather than through these JSON endpoints."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current origin"
    }
  ],
  "tags": [
    { "name": "System" },
    { "name": "Stashes" },
    { "name": "Sync" }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Inspect site liveness and recovery-lab state",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "The public site or enabled recovery lab is alive.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "summary": "Read this OpenAPI document",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/stashes": {
      "get": {
        "operationId": "listStashes",
        "summary": "List committed stashes in the prototype workspace",
        "tags": ["Stashes"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Committed stashes, newest first.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StashList" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "408": { "$ref": "#/components/responses/RequestAborted" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/sync/plans": {
      "post": {
        "operationId": "createSyncPlan",
        "summary": "Plan an immutable archive upload",
        "description": "Returns a direct upload grant only when the SHA-256-addressed object is missing. Protocol v1 accepts only application/vnd.filecheap.stash archives. The receipt authorizes a later catalog commit and expires with this prototype plan.",
        "tags": ["Sync"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePlanInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Upload plan created.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SyncPlan" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "408": { "$ref": "#/components/responses/RequestAborted" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/sync/commits": {
      "post": {
        "operationId": "commitSyncPlan",
        "summary": "Commit a completed upload to the catalog",
        "tags": ["Sync"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CommitPlanInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The archive reference is committed. A full download remains required before local eviction.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CommitPlanResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/InvalidCapability" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "408": { "$ref": "#/components/responses/RequestAborted" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "410": { "$ref": "#/components/responses/ExpiredCapability" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/sync/downloads": {
      "post": {
        "operationId": "createDownloadPlan",
        "summary": "Issue an exact archive download grant",
        "tags": ["Sync"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateDownloadInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Download grant created.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DownloadPlan" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "408": { "$ref": "#/components/responses/RequestAborted" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Development-only static token in the current single-workspace lab."
      }
    },
    "headers": {
      "RequestId": {
        "description": "Opaque identifier for correlating one HTTP request.",
        "schema": { "type": "string" }
      },
      "RetryAfter": {
        "description": "Seconds to wait before retrying a transient operation.",
        "schema": { "type": "string", "pattern": "^[0-9]+$" }
      },
      "WwwAuthenticate": {
        "description": "Bearer authentication challenge.",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request body was not valid JSON or otherwise malformed.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer token.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
          "WWW-Authenticate": { "$ref": "#/components/headers/WwwAuthenticate" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "InvalidCapability": {
        "description": "The signed commit capability is invalid or outside its scope.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "ExpiredCapability": {
        "description": "The signed commit capability expired; create a fresh plan.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "NotFound": {
        "description": "The requested resource does not exist.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "Conflict": {
        "description": "The request conflicts with immutable or current catalog state.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "ValidationError": {
        "description": "The JSON parsed but failed semantic validation.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "The request Content-Type is not application/json.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "The control-plane JSON body exceeds the 16 KiB limit.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "RequestAborted": {
        "description": "The client disconnected or canceled before the storage operation completed. A dispatched commit may require catalog reconciliation.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected control-plane failure.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "A transient catalog contention or dependency failure. Retry after the advertised delay.",
        "headers": {
          "Retry-After": { "$ref": "#/components/headers/RetryAfter" },
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      }
    },
    "schemas": {
      "Sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$",
        "examples": ["d6b4eedf33431535c7214396a2bc571788c259e3d1a68d143ede79e81cc33fe4"]
      },
      "StashId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "Health": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["database", "deployment", "recoveryLab", "status", "storage", "storageVerification", "version"],
            "properties": {
              "database": { "const": "none" },
              "deployment": { "const": "public-site" },
              "recoveryLab": { "const": "disabled" },
              "status": { "const": "ok" },
              "storage": { "const": "disabled" },
              "storageVerification": { "const": "not-applicable" },
              "version": { "const": "filecheap-site/1" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["database", "deployment", "recoveryLab", "status", "storage", "storageVerification", "version"],
            "properties": {
              "database": { "const": "none" },
              "deployment": { "const": "local-prototype" },
              "recoveryLab": { "const": "enabled" },
              "status": { "const": "ok" },
              "storage": { "enum": ["local", "vercel-blob"] },
              "storageVerification": { "enum": ["presence-size-etag", "server-sha256"] },
              "version": { "const": "filecheap-sync/1" }
            }
          }
        ]
      },
      "StashSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["committedAt", "contentType", "sha256", "sizeBytes", "stashId", "storageVerification"],
        "properties": {
          "committedAt": { "type": "string", "format": "date-time", "minLength": 20, "maxLength": 40 },
          "contentType": { "const": "application/vnd.filecheap.stash" },
          "sha256": { "$ref": "#/components/schemas/Sha256" },
          "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
          "stashId": { "$ref": "#/components/schemas/StashId" },
          "storageVerification": {
            "enum": ["presence-size-etag", "server-sha256"],
            "description": "Evidence available at catalog commit time. A full client download and SHA-256 check is still required for recovery proof."
          }
        }
      },
      "StashList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stashes", "version"],
        "properties": {
          "stashes": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": { "$ref": "#/components/schemas/StashSummary" }
          },
          "version": { "const": "filecheap-sync/1" }
        }
      },
      "CreatePlanInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "sizeBytes", "stashId"],
        "properties": {
          "contentType": {
            "const": "application/vnd.filecheap.stash",
            "default": "application/vnd.filecheap.stash"
          },
          "sha256": { "$ref": "#/components/schemas/Sha256" },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "stashId": { "$ref": "#/components/schemas/StashId" }
        }
      },
      "TransferGrant": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expiresAt", "headers", "method", "url"],
        "properties": {
          "expiresAt": { "type": "string", "format": "date-time", "minLength": 20, "maxLength": 40 },
          "headers": {
            "type": "object",
            "maxProperties": 16,
            "propertyNames": { "minLength": 1, "maxLength": 128 },
            "additionalProperties": { "type": "string", "maxLength": 4096 }
          },
          "method": { "enum": ["GET", "PUT"] },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 8192,
            "description": "HTTPS transfer URL, or HTTP only on an explicit loopback host for local development. Credentials and fragments are forbidden."
          }
        }
      },
      "UploadTransferGrant": {
        "allOf": [
          { "$ref": "#/components/schemas/TransferGrant" },
          {
            "type": "object",
            "required": ["method"],
            "properties": { "method": { "const": "PUT" } }
          }
        ]
      },
      "DownloadTransferGrant": {
        "allOf": [
          { "$ref": "#/components/schemas/TransferGrant" },
          {
            "type": "object",
            "required": ["method"],
            "properties": { "method": { "const": "GET" } }
          }
        ]
      },
      "SyncPlan": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object", "receipt", "state", "upload", "version"],
        "properties": {
          "object": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "sha256", "sizeBytes"],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "description": "Immutable object key ending in /{sha256}.fcheap."
              },
              "sha256": { "$ref": "#/components/schemas/Sha256" },
              "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 }
            }
          },
          "receipt": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "state": { "enum": ["already_committed", "object_present", "upload_required"] },
          "upload": {
            "anyOf": [
              { "$ref": "#/components/schemas/UploadTransferGrant" },
              { "type": "null" }
            ]
          },
          "version": { "const": "filecheap-sync/1" }
        },
        "allOf": [
          {
            "if": {
              "required": ["state"],
              "properties": { "state": { "const": "upload_required" } }
            },
            "then": {
              "required": ["upload"],
              "properties": {
                "upload": { "$ref": "#/components/schemas/UploadTransferGrant" }
              }
            }
          },
          {
            "if": {
              "required": ["state"],
              "properties": {
                "state": { "enum": ["already_committed", "object_present"] }
              }
            },
            "then": {
              "required": ["upload"],
              "properties": { "upload": { "type": "null" } }
            }
          }
        ]
      },
      "CommitPlanInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receipt"],
        "properties": {
          "receipt": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      },
      "CommitPlanResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requiresFullVerification", "stash", "version"],
        "properties": {
          "requiresFullVerification": { "const": true },
          "stash": { "$ref": "#/components/schemas/StashSummary" },
          "version": { "const": "filecheap-sync/1" }
        }
      },
      "CreateDownloadInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stashId"],
        "properties": {
          "stashId": { "$ref": "#/components/schemas/StashId" }
        }
      },
      "DownloadPlan": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected", "grant", "mustVerifySha256", "stashId", "version"],
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256", "sizeBytes"],
            "properties": {
              "sha256": { "$ref": "#/components/schemas/Sha256" },
              "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 }
            }
          },
          "grant": { "$ref": "#/components/schemas/DownloadTransferGrant" },
          "mustVerifySha256": { "const": true },
          "stashId": { "$ref": "#/components/schemas/StashId" },
          "version": { "const": "filecheap-sync/1" }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail", "requestId", "status", "title", "type"],
        "properties": {
          "code": { "type": "string" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "requestId": { "type": "string" },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "title": { "type": "string" },
          "type": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
