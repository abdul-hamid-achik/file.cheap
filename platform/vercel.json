{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "preview": true
    }
  },
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':!CHANGELOG.md' ':!CHANGELOG*' ':!AGENTS.md' ':!CLAUDE.md' ':!.github' ':!.github/**'",
  "framework": "nextjs",
  "installCommand": "bun install --frozen-lockfile && bun install --cwd docs --frozen-lockfile",
  "buildCommand": "bun run build",
  "crons": [
    { "path": "/api/internal/retention", "schedule": "17 * * * *" }
  ]
}
